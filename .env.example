# Copy to .env and fill in. Never commit .env.

# Supabase (publishable values, safe for the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase (server-side copies of the same values)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Google Gemini (server only)
GEMINI_API_KEY=
# Optional: override the default Gemini model
GEMINI_MODEL=

# Optional: show Google sign-in and Google Calendar import (see docs/GOOGLE_SETUP.md)
VITE_ENABLE_GOOGLE=false
